rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function approvedStaff(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        profile(uid).role in [
          'doctor',
          'admin',
          'system_admin',
          'health_worker',
          'health worker',
          'nurse',
          'midwife'
        ] &&
        profile(uid).facilityId is string &&
        profile(uid).facilityId != '' &&
        profile(uid).facilityName is string &&
        profile(uid).facilityName != '';
    }

    function systemAdministrator(uid) {
      return approvedStaff(uid) && profile(uid).role == 'system_admin';
    }

    function motherProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        profile(uid).role == 'mother';
    }

    function sameFacilityAsStaff(motherUid) {
      return approvedStaff(request.auth.uid) &&
        motherProfile(motherUid) &&
        profile(motherUid).facilityId is string &&
        profile(motherUid).facilityId != '' &&
        (systemAdministrator(request.auth.uid) ||
          profile(motherUid).facilityId == profile(request.auth.uid).facilityId);
    }

    function mutableMotherProfileFields() {
      return [
        'fullName',
        'email',
        'age',
        'village',
        'phone',
        'language',
        'maternalStatus',
        'pregnancyStage',
        'parity',
        'conditions',
        'midwifeName',
        'midwifePhone',
        'updatedAt'
      ];
    }

    match /users/{userId} {
      allow get, list: if signedIn() && (
        request.auth.uid == userId ||
        (sameFacilityAsStaff(userId) && resource.data.facilityId == profile(request.auth.uid).facilityId)
      );

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'mother' &&
        request.resource.data.facilityId is string &&
        request.resource.data.facilityId != '' &&
        request.resource.data.facilityName is string;

      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'mother' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(mutableMotherProfileFields());

      allow delete: if false;

      match /{subcollection=**} {
        allow read, write: if signedIn() && (
          request.auth.uid == userId || sameFacilityAsStaff(userId)
        );
      }
    }

    match /staffDirectory/{staffId} {
      allow read: if resource.data.active == true &&
        resource.data.role == 'midwife' &&
        resource.data.keys().hasOnly([
          'fullName',
          'phone',
          'facilityId',
          'facilityName',
          'role',
          'active'
        ]);
      allow write: if false;
    }

    match /ussd_requests/{requestId} {
      allow read: if approvedStaff(request.auth.uid) &&
        (systemAdministrator(request.auth.uid) ||
          resource.data.facilityId == profile(request.auth.uid).facilityId);
      allow write: if false;
    }

    match /sms_logs/{logId} {
      allow read: if approvedStaff(request.auth.uid) &&
        (systemAdministrator(request.auth.uid) ||
          resource.data.facilityId == profile(request.auth.uid).facilityId);
      allow write: if false;
    }

    match /facilities/{facilityId} {
      allow get: if approvedStaff(request.auth.uid) &&
        (systemAdministrator(request.auth.uid) ||
          facilityId == profile(request.auth.uid).facilityId);
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
